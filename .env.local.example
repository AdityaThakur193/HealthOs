# ==============================================================================
# Health OS Environment Configuration Template (.env.local)
# ==============================================================================

# 1. MongoDB Database Connection URI (Atlas Cloud Cluster or Local Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthos

# 2. Google Gemini API Key (Primary Vision & Grounded Diet Generator Engine)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq API Key (Coach and text meal analysis)
# Obtain from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 4. Secret that signs login sessions and login codes.
# Required in production, at least 32 characters. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# 5. Resend API key for login emails. Required in production.
# In development, leave it empty and the code is printed in the server console.
# Obtain from: https://resend.com/
RESEND_API_KEY=

# 6. Sender for login emails. Must be on a domain verified in Resend, because
# the default onboarding@resend.dev sender only delivers to your own address.
EMAIL_FROM=HealthOS <onboarding@resend.dev>

# 7. Meal reminders (optional). Generate the key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 8. Protects the scheduled reminder job. Must also be set as the CRON_SECRET
# GitHub Actions secret, with the APP_URL repository variable set to your site.
CRON_SECRET=
